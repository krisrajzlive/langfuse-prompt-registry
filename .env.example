# Langfuse. Create the key pair in the Langfuse UI:
# Project Settings -> API Keys -> Create new API key.
# Host by region: https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com,
# https://jp.cloud.langfuse.com, or your own URL if self-hosting.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Amazon Bedrock (credentials come from the standard AWS chain: env vars or profile)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
